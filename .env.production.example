# MetaGauge Production Environment Variables
# Copy this to your Render dashboard: Settings → Environment

# =============================================================================
# DATABASE CONFIGURATION (NEON)
# =============================================================================
DATABASE_TYPE=postgres
DATABASE_URL=postgresql://username:password@ep-your-endpoint.region.aws.neon.tech/neondb?sslmode=require

# Legacy format (optional, DATABASE_URL takes precedence)
POSTGRES_HOST=ep-your-endpoint.region.aws.neon.tech
POSTGRES_PORT=5432
POSTGRES_DB=neondb
POSTGRES_USER=your_username
POSTGRES_PASSWORD=your_password
POSTGRES_SSL=true
POSTGRES_MAX_CONNECTIONS=10

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
NODE_ENV=production
PORT=10000
FRONTEND_URL=https://your-frontend.pages.dev

# =============================================================================
# AUTHENTICATION
# =============================================================================
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long

# =============================================================================
# AI SERVICES (GOOGLE GEMINI)
# =============================================================================
GEMINI_API_KEY=your-primary-gemini-api-key
GEMINI_API_KEY_2=your-backup-key-1
GEMINI_API_KEY_3=your-backup-key-2
GEMINI_API_KEY_4=your-backup-key-3
GEMINI_API_KEY_5=your-backup-key-4
GEMINI_API_KEY_6=your-backup-key-5
GEMINI_API_KEY_7=your-backup-key-6
GEMINI_API_KEY_8=your-backup-key-7
GEMINI_API_KEY_9=your-backup-key-8
GEMINI_API_KEY_10=your-backup-key-9

# =============================================================================
# BLOCKCHAIN RPC ENDPOINTS
# =============================================================================
# Ethereum Mainnet
ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/your-api-key

# Ethereum Sepolia Testnet
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your-api-key

# Lisk Mainnet
LISK_RPC_URL=https://rpc.api.lisk.com

# Lisk Sepolia Testnet  
LISK_SEPOLIA_RPC_URL=https://rpc.sepolia-api.lisk.com

# Base Mainnet (if needed)
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/your-api-key

# Optimism (if needed)
OPTIMISM_RPC_URL=https://opt-mainnet.g.alchemy.com/v2/your-api-key

# Polygon (if needed)
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/your-api-key

# =============================================================================
# PAYMENT PROCESSING
# =============================================================================
# Paystack (for Nigerian payments)
PAYSTACK_SECRET_KEY=sk_live_your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_live_your_paystack_public_key

# Flutterwave (alternative)
FLUTTERWAVE_SECRET_KEY=FLWSECK-your-secret-key
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK-your-public-key

# On-chain payment verification address
PAYMENT_ADDRESS=0xYourPaymentWalletAddress

# =============================================================================
# MONGODB (OPTIONAL - for legacy features)
# =============================================================================
MONGO_URL=mongodb+srv://username:password@cluster.mongodb.net/metagauge?retryWrites=true&w=majority
MONGO_DB=metagauge

# =============================================================================
# EMAIL (OPTIONAL - for notifications)
# =============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password

# =============================================================================
# ERROR TRACKING (OPTIONAL - Sentry)
# =============================================================================
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200

# =============================================================================
# WEBSOCKET CONFIGURATION
# =============================================================================
WS_HEARTBEAT_INTERVAL=30000
WS_TIMEOUT=60000

# =============================================================================
# FEATURE FLAGS (OPTIONAL)
# =============================================================================
ENABLE_AI_FEATURES=true
ENABLE_COMPETITIVE_ANALYSIS=true
ENABLE_WALLET_ENRICHMENT=true
ENABLE_RESEARCH_AGENT=true

# =============================================================================
# NOTES
# =============================================================================
# 1. NEVER commit this file with real values to Git
# 2. Use Render's secret management for sensitive keys
# 3. Rotate keys regularly (every 90 days recommended)
# 4. Test in staging environment first
# 5. Monitor logs after deployment
